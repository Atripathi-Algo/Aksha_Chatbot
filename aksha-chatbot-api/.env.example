# Copy this file to .env and fill in real values. Never commit .env itself.

# Which provider each call should use. Swapping this is the only change needed
# to move between cloud (Groq) and on-prem (Ollama) inference.
CHATBOT_MODEL_PROVIDER=ollama
# CHATBOT_MODEL_PROVIDER=groq

# --- Groq (cloud, free developer tier — https://console.groq.com) ---
# Available models vary by account — verify with client.models.list() before assuming
# a model name works. This project's key does not have Llama models, only gpt-oss/Qwen.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (local, always free — https://ollama.com) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Existing Aksha Node backend this chatbot reads from ---
# Local dev default (Node backend running natively on this machine).
# In docker-compose.chatbot.yml this is overridden to the in-network
# container hostname (http://node_backend:5000) — see that file's comments.
NODE_API_BASE_URL=http://localhost:5000
NODE_API_TIMEOUT_SECONDS=5

# --- Additional backend service (ServiceAPI, image analysis / insight
# heatmaps / alert-report analysis) — connectivity groundwork only, no tool
# calls this yet. See service_api_client.py's module docstring for why. ---
SERVICE_API_BASE_URL=http://localhost:4000
SERVICE_API_TIMEOUT_SECONDS=15
