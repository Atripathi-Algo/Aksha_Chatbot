# Aksha Chatbot — single config file for the Docker deployment.
# Copy to chatbot.env and fill in real values (never commit chatbot.env itself).
#
# This one file does two jobs: docker compose reads it (via --env-file) for
# ${VAR} substitution of the published host ports below, AND it's passed into
# the aksha-chatbot-api container as its runtime environment (env_file:).
# Change a port or a backend address here — no docker-compose.chatbot.yml
# edits needed.

# --- Host ports this deployment publishes ---
CHATBOT_API_PORT=8010
CHATBOT_UI_PORT=8080

# Host path to Aksha's generated reports and camera data. The API mounts this
# read-only and reads insight_report/*.json directly when those reports exist.
AKSHA_HOST_DATA_PATH=../Aksha

# --- The existing Aksha stack this chatbot reads from ---
# Container DNS names on the `aksha-net` Docker network (docker-compose.yml's
# node_backend and service_api services). If the real Aksha stack isn't on
# that network — e.g. it runs natively, not in Docker — use
# http://host.docker.internal:<port> for each instead.
NODE_API_BASE_URL=http://node_backend:5000
NODE_API_TIMEOUT_SECONDS=5
# Additional backend service (ServiceAPI) — connectivity groundwork only;
# no tool calls this yet. See service_api_client.py for why.
SERVICE_API_BASE_URL=http://service_api:4000
SERVICE_API_TIMEOUT_SECONDS=15
# Aksha's own frontend (:3000) and MongoDB (:27017) are deliberately not
# configured here — the chatbot never calls the frontend, and per
# docs/CHATBOT_SYSTEM_ARCHITECTURE.md's Section 3.1, no tool ever queries
# MongoDB directly; every read goes through node_backend's existing API.

# --- LLM provider ---
# CHATBOT_MODEL_PROVIDER=ollama
# CHATBOT_MODEL_PROVIDER=groq
CHATBOT_MODEL_PROVIDER=gemini

# --- Model tiering (Section 4.5/4.6): router classification and formatter
# prose fire on every single turn and need no deep reasoning, so they use
# the _CHEAP variant below; domain-worker tool-calling reasoning always uses
# the plain (strong) *_MODEL. Omit a *_CHEAP var to use the strong model for
# both tiers — safe default, especially for Ollama where a cheap tier only
# helps if a second, smaller model is actually pulled locally.

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_CHEAP=gemini-flash-lite-latest

# --- Groq (cloud, free developer tier — https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_CHEAP=openai/gpt-oss-20b

# --- Ollama (local, always free — https://ollama.com) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_MODEL_CHEAP=llama3.2:3b   # only if you've actually pulled a smaller model

# --- Live frame-arrival probe (app/socket_probe.py) ---
# Live Monitoring and Camera Troubleshooting confirm video is actually
# arriving by listening on each camera's Socket.IO frame channel for this
# long. Measured 2026-09-16: 1.5s was flaky (false "not streaming" for a
# healthy 3-FPS camera), 3s+ was reliable. Lower = faster turns but more
# false alarms; the diagnostic tool uses the longer window since a false
# "broken camera" diagnosis is worse than a slower answer.
LIVE_PROBE_TIMEOUT_SECONDS=4.0
DIAGNOSTIC_PROBE_TIMEOUT_SECONDS=6.0

# --- Cost/budget tracking (Section 4.5 #8 / 5.3 / 8.2) ---
# Every LLM call is logged with its token counts and estimated cost
# (app/cost_tracker.py). Per-token dollar rates default to 0 (unpriced) —
# Groq's tracked models are on a free, unmetered tier and Ollama is always
# local, so $0 is accurate for both; Gemini's real rate isn't verified in
# this codebase, so fill in real numbers from your own billing console
# before this reflects true spend for it. Uncomment and set real $/1M-token
# rates to get a real dollar estimate instead of token counts alone.
# GEMINI_COST_PER_1M_INPUT=0.10
# GEMINI_COST_PER_1M_OUTPUT=0.40
# A per-model override, if you need one model priced differently than the
# provider-wide default above (model name uppercased, non-alnum -> "_"):
# GEMINI_COST_PER_1M_INPUT_GEMINI_3_6_FLASH=0.10

# Daily budget in USD — 0 (default) disables the 70/90/100% alert log lines
# entirely (Section 5.3); set a real number to get daily_cost_budget_alert
# warnings and the budget_pct figure on GET /v1/health/ready.
CHATBOT_DAILY_COST_LIMIT=0

# --- Optional tracing (Section 6.1) — off by default, safe no-op until set ---
# Sends real prompts/completions/tool-call args to LangSmith's hosted
# service (smith.langchain.com) once enabled — that's operator queries and
# camera/alert data leaving this deployment for a third-party SaaS, so only
# turn this on for dev/eval, per Section 6.1's own "with redaction" caveat,
# and never against a real customer's data without checking your data
# handling policy first.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aksha-chatbot
